// 暖白纸质感配色（覆盖 Cactus 默认 classic）
// 基调：纸白 #faf9f7 / 墨色 #22272a / 陶土红与青绿双强调
$color-background = #faf9f7
$color-footer-mobile-1 = darken($color-background, 2%)
$color-footer-mobile-2 = darken($color-background, 8%)
$color-background-code = #f3f1ed
$color-border = rgba(34, 39, 42, 0.14)
$color-scrollbar = #c9c5be
$color-meta = #8a857d
$color-meta-code = #6f6a63
$color-link = #2f6f68
$color-text = #22272a
$color-accent-1 = #a8553f
$color-accent-2 = rgba(47, 111, 104, 0.85)
$color-accent-3 = #8a857d
$color-quote = #a8553f
$highlight = hexo-config("highlight") || "github"
